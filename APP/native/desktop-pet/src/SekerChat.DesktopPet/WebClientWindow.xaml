<ui:FluentWindow x:Class="SekerChat.DesktopPet.WebClientWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="SekerChat"
                 Width="1180"
                 Height="760"
                 MinWidth="760"
                 MinHeight="520"
                 Background="{StaticResource AppBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="Manual">
  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Title="SekerChat"
                 Background="{StaticResource ChromeBackgroundBrush}"
                 ButtonsBackground="{StaticResource ChromeBackgroundBrush}"
                 ButtonsForeground="{StaticResource InkBrush}">
      <ui:TitleBar.TrailingContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Height="28"
                  Margin="0,0,6,0"
                  Padding="10,0"
                  VerticalAlignment="Center"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource SubtleBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="ConnectionDot"
                      Width="7"
                      Height="7"
                      Margin="0,0,7,0"
                      Background="#F0B232"
                      CornerRadius="4" />
              <TextBlock x:Name="ConnectionText"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Foreground="{StaticResource MutedBrush}"
                         Text="正在连接" />
            </StackPanel>
          </Border>

          <ui:Button Width="36"
                     Height="32"
                     Margin="0,0,4,0"
                     Padding="0"
                     Appearance="Secondary"
                     Click="More_Click"
                     ToolTip="更多">
            <ui:SymbolIcon Symbol="MoreHorizontal24" />
            <ui:Button.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="BackMenuItem"
                          Header="后退"
                          Click="Back_Click"
                          InputGestureText="Alt+←" />
                <MenuItem x:Name="ForwardMenuItem"
                          Header="前进"
                          Click="Forward_Click"
                          InputGestureText="Alt+→" />
                <MenuItem Header="刷新" Click="Refresh_Click" InputGestureText="Ctrl+R" />
                <Separator />
                <MenuItem Header="隐藏到托盘" Click="Hide_Click" />
              </ContextMenu>
            </ui:Button.ContextMenu>
          </ui:Button>
        </StackPanel>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <Grid Grid.Row="1" Background="{StaticResource AppBackgroundBrush}">
      <wv2:WebView2 x:Name="Browser" />

      <Border x:Name="LoadingOverlay" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <Border Width="56"
                  Height="56"
                  Margin="0,0,0,20"
                  HorizontalAlignment="Center"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource SubtleBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="18">
            <ui:SymbolIcon HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="26"
                           Foreground="{StaticResource AccentBrush}"
                           Symbol="Chat24" />
          </Border>
          <TextBlock HorizontalAlignment="Center"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}"
                     Text="正在打开 SekerChat" />
          <TextBlock x:Name="LoadingHint"
                     Margin="0,8,0,18"
                     HorizontalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}"
                     Text="正在初始化软件版"
                     TextAlignment="Center" />
          <ProgressBar Width="180"
                       Height="3"
                       HorizontalAlignment="Center"
                       IsIndeterminate="True" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
