<Window x:Class="SekerChat.DesktopPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220" Height="250"
        Title="SekerChat 桌宠"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <Viewbox Stretch="Fill">
    <Grid x:Name="PetRoot" Width="220" Height="250">
      <Border x:Name="StatusBubble" MinWidth="150" MaxWidth="210"
              Padding="20,12" CornerRadius="24"
              Background="#F7FFFFFF" BorderBrush="#24354D" BorderThickness="3"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Visibility="Collapsed">
        <TextBlock x:Name="BubbleText" FontSize="28" FontWeight="Bold"
                   Foreground="#24354D" TextAlignment="Center"
                   TextOptions.TextFormattingMode="Display" />
      </Border>
      <Image x:Name="PetImage" Width="210" Height="205" Margin="5,40,5,5"
             HorizontalAlignment="Center" VerticalAlignment="Bottom"
             Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Grid>
  </Viewbox>
</Window>
