COMPOSE_PROJECT_NAME=sekerchat
APP_IMAGE_TAG=v0.8.0
APP_NETWORK_NAME=sekerchat_sekerchat

POSTGRES_DB=sekerchat
POSTGRES_USER=sekerchat
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL="postgresql://sekerchat_app:change-this-app-db-password@postgres:5432/sekerchat?schema=public"

APP_BASE_URL=https://im.example.com
API_BASE_URL=https://im.example.com/api
CORS_ORIGINS=https://im.example.com
APP_NETWORK_SUBNET=172.29.0.0/24
FRONTEND_PROXY_IP=172.29.0.10
BACKEND_IP=172.29.0.11
TRUSTED_PROXY_CIDRS=172.29.0.10/32

JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=7d

EMAIL_WHITELIST=alice@example.com,bob@example.com
ADMIN_EMAILS=
BOOTSTRAP_SUPER_ADMIN_EMAIL=

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://im.example.com/api/auth/oidc/callback
OIDC_SCOPES=openid email

S3_ENDPOINT=http://minio:9000
# 可选的对象存储公开端点。设置后，文件下载（presigned URL）由浏览器直连对象存储，
# 前端容器会在启动时把这个明确的 origin 加入 CSP。公开部署应使用 HTTPS；留空时
# 下载和预览继续经过同源后端代理，不需要额外开放对象存储端口。
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=sekerchat
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-root-password
S3_ACCESS_KEY_ID=replace-with-app-access-key
S3_SECRET_ACCESS_KEY=replace-with-app-secret-key
S3_FORCE_PATH_STYLE=true

FILE_ACCESS_SECRET=change-this-file-access-secret
FILE_ACCESS_TTL=10m

TZ=Asia/Shanghai
FRONTEND_PORT=8080
