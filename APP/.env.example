# 本地开发环境变量示例
# 生产环境请使用 deploy/synology/.env.example 并生成强随机密钥
# 本机数据面建议使用 deploy/local-dev/docker-compose.yml 启动

# Backend
HOST=127.0.0.1
PORT=3100
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5173/api
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sekerchat_dev?schema=public"
# 生产环境务必更换为 openssl rand -hex 32 生成的强随机密钥
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=7d
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=sekerchat-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
FILE_ACCESS_SECRET=dev-file-access-secret
FILE_ACCESS_TTL=10m

# Frontend
VITE_API_BASE_URL=/api
VITE_PROXY_API_TARGET=http://127.0.0.1:3100
