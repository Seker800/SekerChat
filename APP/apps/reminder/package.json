{
  "name": "@sekerchat/reminder",
  "version": "0.9.7",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "macOS tray reminder desktop shell for SekerChat",
  "author": "Codex",
  "main": "dist/electron-main.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && node ./scripts/copy-desktop-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:desktop": "npm run build && electron dist/electron-main.js",
    "package:mac": "npm run build && electron-builder --mac zip"
  },
  "build": {
    "appId": "com.sekerchat.desktop",
    "productName": "SekerChat",
    "asar": false,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "extendInfo": {
        "LSUIElement": true
      },
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ]
    },
    "extraMetadata": {
      "main": "dist/electron-main.js"
    }
  },
  "dependencies": {
    "@sekerchat/contracts": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "41.10.4",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
