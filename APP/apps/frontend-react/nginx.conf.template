# One Cache-Control header for every response. Locations must not use their own
# add_header, otherwise nginx drops the server-level security headers.
map $uri $sekerchat_cache_control {
  default "no-cache";
  ~^/assets/ "public, max-age=31536000, immutable";
  ~^/api/ "";
}

server {
  listen 80;
  server_name _;
  server_tokens off;

  # Trust only the configured HTTPS edge. Direct clients cannot supply their IP.
  set_real_ip_from ${SEKERCHAT_TRUSTED_EDGE_PROXY};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  root /usr/share/nginx/html;
  index index.html;
  resolver 127.0.0.11 valid=30s ipv6=off;
  resolver_timeout 5s;
  set $backend_origin http://sekerchat-backend:3100;

  # Every large upload is chunked into 32 MB parts; 64 MB covers any one request
  # while still bounding a slow or oversized body.
  client_max_body_size 64m;
  gzip on;
  gzip_types application/json;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_static on;
  gzip_vary on;

  # The optional object-storage origin is validated and injected at container startup.
  # `img-src`/`media-src` keep `https:` so pasted external images keep working;
  # `script-src` stays same-origin. `frame-ancestors` is configurable so the app
  # can still be embedded in an internal portal when explicitly allowed.
  set $sekerchat_csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob: ${SEKERCHAT_CSP_OBJECT_SOURCE}; media-src 'self' https: data: blob: ${SEKERCHAT_CSP_OBJECT_SOURCE}; font-src 'self' data: https:; connect-src 'self' ws: wss: ${SEKERCHAT_CSP_OBJECT_SOURCE}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors ${SEKERCHAT_CSP_FRAME_ANCESTORS};";

  add_header Content-Security-Policy $sekerchat_csp always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Cache-Control $sekerchat_cache_control always;

  location = /index.html {
    try_files /index.html =404;
  }

  location = /robots.txt {
    default_type text/plain;
    return 200 "User-agent: *\nAllow: /\nDisallow: /admin\nDisallow: /groups\nDisallow: /dm\nDisallow: /s\nSitemap: $scheme://$http_host/sitemap.xml\n";
  }

  location = /sitemap.xml {
    default_type application/xml;
    return 200 '<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml"><url><loc>$scheme://$http_host/</loc><xhtml:link rel="alternate" hreflang="zh-CN" href="$scheme://$http_host/"/><xhtml:link rel="alternate" hreflang="en" href="$scheme://$http_host/en"/></url><url><loc>$scheme://$http_host/en</loc><xhtml:link rel="alternate" hreflang="zh-CN" href="$scheme://$http_host/"/><xhtml:link rel="alternate" hreflang="en" href="$scheme://$http_host/en"/></url></urlset>';
  }

  location /assets/ {
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    proxy_pass $backend_origin;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Forward only the address resolved through the explicit edge trust boundary.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 文件下载：关缓冲立即流式传输，大文件不被超时切断
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 600s;

    # 大文件上传：客户端请求体发送超时
    client_body_timeout 600s;
  }

  location /realtime {
    proxy_pass $backend_origin;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 600s;
  }
}
