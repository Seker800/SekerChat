HOST=127.0.0.1
PORT=3100
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5173/api
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sekerchat_dev?schema=public"
# 生产环境务必更换为 openssl rand -hex 32 生成的强随机密钥
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=7d
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
OIDC_SCOPES=openid email
ADMIN_EMAILS=
# 首次上线时建议设置为预期首个超级管理员邮箱；首个账号只允许该邮箱拿到 SUPER_ADMIN
BOOTSTRAP_SUPER_ADMIN_EMAIL=
S3_ENDPOINT=http://127.0.0.1:9000
# 可选：对象存储直连下载/预览优化。多访问入口场景建议留空，上传默认走同源 API 代理。
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=sekerchat-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# 生产环境务必更换为 openssl rand -hex 32 生成的强随机密钥
FILE_ACCESS_SECRET=dev-file-access-secret
FILE_ACCESS_TTL=10m
NODE_ENV=development
