# ─── Build stage ───────────────────────────────────────────────
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build

RUN apk add --no-cache python3 make g++ curl

WORKDIR /app

# Copy npm config files for workspace install
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/
COPY apps/frontend-react/package.json apps/frontend-react/
COPY apps/ui-lab/package.json apps/ui-lab/
COPY apps/reminder/package.json apps/reminder/
COPY packages/shared/package.json packages/shared/

RUN npm ci

# Copy source code
COPY apps/backend/ apps/backend/
COPY packages/shared/ packages/shared/

# Compile shared package TS → JS (CJS for backend, ESM for frontend)
WORKDIR /app/packages/shared
RUN echo '{"compilerOptions":{"module":"commonjs","target":"es2021","declaration":true,"esModuleInterop":true,"skipLibCheck":true,"outDir":"dist"},"include":["src/work-status.ts"]}' > tsconfig.cjs.json && \
    npx tsc --project tsconfig.cjs.json && \
    mv dist/work-status.js dist/work-status.cjs && \
    rm tsconfig.cjs.json
RUN echo '{"compilerOptions":{"module":"esnext","target":"es2021","declaration":false,"esModuleInterop":true,"skipLibCheck":true,"outDir":"dist"},"include":["src/work-status.ts"]}' > tsconfig.esm.json && \
    npx tsc --project tsconfig.esm.json && \
    mv dist/work-status.js dist/work-status.mjs && \
    rm tsconfig.esm.json
RUN node -e "const p=require('./package.json'); p.main='./dist/work-status.cjs'; p.types='./dist/work-status.d.ts'; p.exports={'.':{import:'./dist/work-status.mjs',require:'./dist/work-status.cjs',types:'./dist/work-status.d.ts'}}; require('fs').writeFileSync('./package.json', JSON.stringify(p,null,2))"

WORKDIR /app/apps/backend

RUN npx prisma generate
RUN npm run build

# ─── Runtime stage ─────────────────────────────────────────────
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

RUN apk add --no-cache curl

WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=build /app/apps/backend/dist ./dist
COPY --from=build /app/apps/backend/prisma ./prisma
COPY --from=build /app/apps/backend/package.json ./package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json

# Ensure workspace symlinks for local packages and generated client
RUN mkdir -p node_modules/@sekerchat && \
    ln -sf ../../packages/shared node_modules/@sekerchat/shared && \
    mkdir -p node_modules/@prisma && \
    ln -sf ../../apps/backend/node_modules/@prisma/client node_modules/@prisma/client

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3100

ENTRYPOINT ["/entrypoint.sh"]
